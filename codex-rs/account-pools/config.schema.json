{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccountPoolConfig",
  "type": "object",
  "required": [
    "accounts",
    "pools"
  ],
  "properties": {
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ManagedAccount"
      }
    },
    "defaultSelection": {
      "anyOf": [
        {
          "$ref": "#/definitions/AccountSelection"
        },
        {
          "type": "null"
        }
      ]
    },
    "pools": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AccountPool"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AccountPool": {
      "type": "object",
      "required": [
        "accounts",
        "name",
        "redeemWeeklyResets"
      ],
      "properties": {
        "accounts": {
          "description": "Ordered aliases. The order breaks quota and reset-credit ties.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1
        },
        "name": {
          "type": "string"
        },
        "redeemWeeklyResets": {
          "description": "Use existing banked credits only when every eligible account is weekly exhausted.",
          "type": "boolean"
        }
      }
    },
    "AccountSelection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "name",
            "type"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "account"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "name",
            "type"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "pool"
              ]
            }
          }
        }
      ]
    },
    "ManagedAccount": {
      "type": "object",
      "required": [
        "alias",
        "userId",
        "workspaceId"
      ],
      "properties": {
        "alias": {
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        },
        "userId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      }
    }
  }
}
