{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AccountSelection": {
      "oneOf": [
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "account"
              ],
              "title": "AccountAccountSelectionType",
              "type": "string"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "title": "AccountAccountSelection",
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "pool"
              ],
              "title": "PoolAccountSelectionType",
              "type": "string"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "title": "PoolAccountSelection",
          "type": "object"
        }
      ]
    },
    "ManagedAccountAction": {
      "enum": [
        "add",
        "import",
        "list",
        "select",
        "remove",
        "usage",
        "redeem",
        "resolve",
        "models"
      ],
      "type": "string"
    }
  },
  "properties": {
    "accountSelection": {
      "anyOf": [
        {
          "$ref": "#/definitions/AccountSelection"
        },
        {
          "type": "null"
        }
      ],
