    },
    "action": {
      "$ref": "#/definitions/ManagedAccountAction"
    },
    "alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "deviceAuth": {
      "description": "Use device-code login for `add`; defaults to browser OAuth.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "limit": {
      "format": "uint32",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "action"
  ],
  "title": "ManagedAccountParams",
  "type": "object"
